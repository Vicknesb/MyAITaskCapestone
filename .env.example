# ─── Required — server will not start without these ───────────────────────────

# PostgreSQL connection string used by Prisma at runtime
DATABASE_URL="postgresql://postgres:password@localhost:5432/devpulse"

# Random string used to sign JWTs — minimum 32 characters, must be kept secret
# Generate: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Base64-encoded 32-byte master key for AES-256-GCM encryption of stored GitHub tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="base64-encoded-32-byte-key-here"

# ─── Required for tests only ──────────────────────────────────────────────────

# Separate PostgreSQL database used by Vitest integration tests (reset each run)
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/devpulse_test"

# ─── Optional — has safe defaults ─────────────────────────────────────────────

# Runtime environment — affects cookie security flags and Prisma logging
# Values: development | production | test
NODE_ENV=development

# Port the Express API server listens on (default: 3000 if unset)
PORT=4000

# Origin the Express CORS middleware allows (default: http://localhost:3000)
ALLOWED_ORIGIN="http://localhost:3000"

# Where next.config.ts rewrites /api/* requests to — must match PORT above
API_URL="http://localhost:4000"
