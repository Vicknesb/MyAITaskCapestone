# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma at runtime
DATABASE_URL="postgresql://postgres:password@localhost:5432/devpulse"

# Separate PostgreSQL database used by Vitest integration tests only
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/devpulse_test"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Random string used to sign JWTs — minimum 32 characters, must be secret
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Base64-encoded 32-byte key used to AES-256-GCM encrypt stored GitHub tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="base64-encoded-32-byte-key-here"

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Express API server listens on (default: 3000 if unset)
PORT=4000

# Origin the Express CORS middleware allows (default: http://localhost:3000)
ALLOWED_ORIGIN="http://localhost:3000"

# ─── Next.js ──────────────────────────────────────────────────────────────────
# Where next.config.ts rewrites /api/* requests to
# Must match the Express server's PORT above
API_URL="http://localhost:4000"
