tsconfig.tsbuildinfo

# Test coverage reports (HTML/lcov excluded; coverage-summary.json committed in root)
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma generated client (generated at deploy time)
/generated/prisma

# OS files
.DS_Store
Thumbs.db
